<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Sandbox MUST be off. Isle dlopen()s a private framework (MediaRemote), reads the
	     IORegistry for battery/AirPods state, and watches ~/Library/DoNotDisturb. None of that is
	     reachable from inside a sandbox, which is also why Isle can never ship on the Mac App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- Required once you turn Hardened Runtime ON for Developer ID notarization: without it the
	     runtime refuses to dlopen() MediaRemote.framework because it is not part of the app bundle. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!-- EventKit calendar access (only enforced under Hardened Runtime / sandbox, harmless otherwise). -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>

	<!-- Used by the AppleScript Now Playing fallback (Music.app / Spotify). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
